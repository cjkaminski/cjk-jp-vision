# Copy to .env and edit. The server reads these at startup.

# --- OCR ---
# Which OCR engine to use by default: apple_vision | manga_ocr | mock
# (The UI can override per-request; "auto" picks the best available.)
OCR_BACKEND=auto

# --- Analysis (translation + grammar breakdown) ---
# Default analysis engine: claude_cli | local_llm | anthropic_api | mock
ANALYSIS_BACKEND=auto

# claude_cli: path to the Claude Code CLI (uses your Max subscription, no API key)
CLAUDE_CLI_PATH=claude
# Optional: pin a model for the CLI, e.g. claude-opus-4-8 (leave blank for default)
CLAUDE_CLI_MODEL=

# local_llm: OpenAI-compatible endpoint on your GPU box.
# Ollama default is http://localhost:11434/v1 ; vLLM is usually http://HOST:8000/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b-instruct
LOCAL_LLM_API_KEY=not-needed

# anthropic_api (optional, needs real API billing — NOT your Max subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Tokenizer ---
USE_MECAB=1   # 1 to add MeCab/fugashi word segmentation, 0 to skip

# --- Server ---
HOST=0.0.0.0
PORT=8000
